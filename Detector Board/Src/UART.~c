//------------------------------------------------------------------------------
// control on/off, blinking, and color
void Process_Radio_RX_RGB_Indicator_Control(uint8_t *pRGB_Indicator_Control_Msg) {
  Radio_RX_RGB_Indicator_Control_Msg_t *pMsg = (Radio_RX_RGB_Indicator_Control_Msg_t *) pRGB_Indicator_Control_Msg;

  // light show is controlled by mobile app
  LightShow_Selector = -1;

  // latch timestamp of color change
  TimeStampColorChangeCounter_100ms = TimeStampCounter_100ms;

  uint16_t side  = Convert_ASCII_byte_to_uint16       (pMsg->side);
  uint16_t color = Convert_ASCII_byte_to_uint16       (pMsg->color);
  uint16_t r1    = Convert_ASCII_double_byte_to_uint16(pMsg->r1);
  uint16_t r2    = Convert_ASCII_double_byte_to_uint16(pMsg->r2);
  uint16_t r3    = Convert_ASCII_double_byte_to_uint16(pMsg->r3);
  uint16_t f1    = Convert_ASCII_double_byte_to_uint16(pMsg->f1);
  uint16_t f2    = Convert_ASCII_double_byte_to_uint16(pMsg->f2);
  uint16_t f3    = Convert_ASCII_double_byte_to_uint16(pMsg->f3);

  uint32_t LEDs_on;
  uint32_t LEDs_blink;
  uint32_t RGB;

  // r1 is the upper  8 bits
  // r2 is the middle 8 bits
  // r3 is the lower  8 bits
  // which totals 24 LEDs, but there are 32 LEDs
  // map r1 to 31..24
  // gap       23..20
  // map r2 to 19..12
  // gap       11.. 8
  // map r3 to  7.. 0
  // to fill the gaps, we propagate:
  // bit 24 into 23 and 22
  // bit 19 into 21 and 20
  // bit 12 into 11 and 10
  // bit  7 into  9 and  8
  LEDs_on = (r1 << 24)
          | (r2 << 12)
          | (r3 <<  0);

  if (r1 & 0x01) LEDs_on |= (3ul << 22);
  if (r2 & 0x80) LEDs_on |= (3ul << 20);
  if (r2 & 0x01) LEDs_on |= (3ul << 10);
  if (r3 & 0x80) LEDs_on |= (3ul <<  8);

  LEDs_blink = (f1 << 24)
             | (f2 << 12)
             | (f3 <<  0);

  if (f1 & 0x01) LEDs_blink |= (3ul << 22);
  if (f2 & 0x80) LEDs_blink |= (3ul << 20);
  if (f2 & 0x01) LEDs_blink |= (3ul << 10);
  if (f3 & 0x80) LEDs_blink |= (3ul <<  8);

  switch (color) {
    case 0: RGB = 0x0000fful; break;    // blue
    case 1: RGB = 0x00ff00ul; break;    // green
    case 2: RGB = 0xff0000ul; break;    // red
    case 3: RGB = 0x7f7f00ul; break;    // yellow = red+green
    }

  // 1=left  side (emitter)
  // 2=right side (detector)
  // 3=both  sides
  if (side & 2) {
    // right side (detector)
    RGB_indicators.LEDs1_on    = LEDs_on;
    RGB_indicators.LEDs1_blink = LEDs_blink;
    RGB_indicators.RGB1        = RGB;
    }
  if (side & 1) {
    // left side (emitter)
    // send an RGB indicator message to the emitter
    __NOP();
    }
}

