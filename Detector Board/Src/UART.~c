//------------------------------------------------------------------------------
// the bootloader will support up to 112 k bytes
// the detector build does not have enough ram to capture an entire 112 k byte image
// so we use 96 k bytes instead
#define DETECTOR_IMAGE_SIZE (uint32_t) (96 * 1024)                                      // 112k bytes max in bootloader
#pragma data_alignment=16
uint32_t Detector_code_image[DETECTOR_IMAGE_SIZE/4];
void Process_Radio_RX_Detector_code_image(uint8_t *pCode_image_Msg) {
  Radio_RX_code_image_Msg_t *pMsg = (Radio_RX_code_image_Msg_t *) pCode_image_Msg;      // pointer to message packet
  uint16_t  index                 = pMsg->packet_number;                                // packet number
  uint32_t *data                  = (uint32_t *) &pMsg->data;                           // pointer to packet data
  uint32_t *code                  = &Detector_code_image[index * 4];                    // pointer to code image

  // init the code image when first packet of a fresh download
  if (index == 0) {
    uint16_t i;
    for (i = 0; i < DETECTOR_IMAGE_SIZE/4; i++) Detector_code_image[i] = ~0ul;
    }

  // index * 16 is byte offset into code array
  // check (index * 16) < sizeof(Detector_code_image)
  if (index < (sizeof(Detector_code_image)/16)) {
    // copy 16 bytes into code image
    code[0] = data[0];
    code[1] = data[1];
    code[2] = data[2];
    code[3] = data[3];
    }
}

//------------------------------------------------------------------------------
void Process_Radio_RX_Radio_RX_Restart_now(uint8_t *pCode_image_Msg) {
  // erase sector 7
  Erase_flash_sector(FLASH_SECTOR_7);           // 128 kb

  // copy code image to secondary code image
  Program_flash_sector_word(ADDR_FLASH_SECTOR_7, (uint32_t) &Detector_code_image, DETECTOR_IMAGE_SIZE/4);

  // notify emitter to restart now
  // emitter will reset, causing detector to lose power
  // after power is restored to detector, the detector bootloader will run
  Send_EmitterRestartNowMsg();
}

//------------------------------------------------------------------------------
void RX_ParseRadioTask(uart_t *uart, uint32_t clock_ticks) {
  int16_t  FIFO_count = Uart_RX_FIFO_count(uart);
  uint8_t *pMsg       = uart->RX_empty_ptr;
  uint16_t discard_len;

  if (FIFO_count >= COMMAND_PACKET_LEN) {
    discard_len = COMMAND_PACKET_LEN;

    // request general machine status 0x82, descriptor '0','1'
    if      (RX_String_Mask_Match(pMsg,
                                  (uint8_t *) Radio_RX_General_Machine_Status_Request,
                                  (uint8_t *) Radio_RX_General_Machine_Status_Request_mask,
                                  COMMAND_PACKET_LEN)) Process_Radio_RX_General_Machine_Status_Request(uart);

    // RGB indicator control 0x82, descriptor '0','3'
    else if (RX_String_Mask_Match(pMsg,
                                  (uint8_t *) Radio_RX_RGB_Indicator_Control,
                                  (uint8_t *) Radio_RX_RGB_Indicator_Control_mask,
                                  COMMAND_PACKET_LEN)) Process_Radio_RX_RGB_Indicator_Control(pMsg);

    // RGB indicator crossing action control 0x82, descriptor '0','7'
    else if (RX_String_Mask_Match(pMsg,
                                  (uint8_t *) Radio_RX_RGB_Indicator_Crossing_Action_Control,
                                  (uint8_t *) Radio_RX_RGB_Indicator_Crossing_Action_Control_mask,
                                  COMMAND_PACKET_LEN)) Process_Radio_RX_RGB_Indicator_Crossing_Action_Control(pMsg);

    // emitter code image packet 0x85
    else if (RX_String_Mask_Match(pMsg,
                                  (uint8_t *) Radio_RX_Emitter_code_image,
                                  (uint8_t *) Radio_RX_Emitter_code_image_mask,
                                  COMMAND_PACKET_LEN)) Process_Radio_RX_Emitter_code_image(pMsg);

    // detector code image packet 0x86
    else if (RX_String_Mask_Match(pMsg,
                                  (uint8_t *) Radio_RX_Detector_code_image,
                                  (uint8_t *) Radio_RX_Detector_code_image_mask,
                                  COMMAND_PACKET_LEN)) Process_Radio_RX_Detector_code_image(pMsg);

    // resetart-now packet 0x87
    else if (RX_String_Mask_Match(pMsg,
                                  (uint8_t *) Radio_RX_Restart_now,
                                  (uint8_t *) Radio_RX_Restart_now_mask,
                                  COMMAND_PACKET_LEN)) Process_Radio_RX_Radio_RX_Restart_now(pMsg);

    // message not recognized, discard one byte and try again later
    else discard_len = 1;

    // at this point, we have either processed a valid message or we have not
    // for all valid messages,   discard 20 bytes
    // for all invalid messages, discard one byte and try again later
    Uart_RX_discard_chars(uart, discard_len);
    }
  else if (FIFO_count >= RADIO_INIT_LEN) {
    // Radio_RX_init_string ?SN?\r
    if (RX_String_Match(pMsg,
                        (uint8_t *) Radio_RX_init_string,
                        RADIO_INIT_LEN)) {
      Process_Radio_RX_init_string(uart);
      Uart_RX_discard_chars(uart, RADIO_INIT_LEN);
      }
    }
  else if (FIFO_count >= 1) {
    static  int16_t command_line_state = 0;
    static uint16_t num;
    static uint16_t digit_cnt;
           uint16_t echo = *pMsg;       // character in original case
           uint16_t data = *pMsg;       // character in upper    case

    // convert lower case to upper case
    if ((data >= 'a') && (data <= 'z')) data += 'A' - 'a';

    // assume the parser will consume the character
    discard_len = 1;

    // parse the command set
    switch (command_line_state) {
      case  0: // not doing command set parsing yet
               // %     start command set parsing
               // M     memory update
               if (data == '\r') {
                 Uart_TX_put_str(uart, "\r\n>");
                 }
               else if (data == '%') {
                 // output "COMMAND SET: "
                 Uart_TX_put_str(uart, "COMMAND SET: ");
                 command_line_state = 1;
                 }
               else if (data == 'M') {
                 // memory update
                 // output "Memory Updated\r\n"
                 Uart_TX_put_str(uart, "Memory Updated\r\n>");

                 // write Serial_Number to FRAM
                 Write_SN();
                 }

               // assume we are constructing a longer string to match other commands:
               // "?SN?\r"
               // 0x8x ...         ... 0xcx
               // do not consume the character
               else if (data == '?') discard_len = 0;
               else if (data & 0x80) discard_len = 0;

               // it's not anything we recognize, give error
               else command_line_state = -2;                    // parsing error
               break;
      case  1: // start command set parsing
               // consume the character
               // "SN\n"        show serial number and end command set parsing
               // "SNdddd\n"    set serial number and end command set parsing
               // "\n"          end parsing
               // <other>       parsing error and end command set parsing
               if (data == 'S') {
                 Uart_TX_put_char(uart, echo);                  // echo character
                 command_line_state = 2;                        // continue parsing
                 }
               else if (data == '\n') command_line_state = -1;  // end parsing
               else                   command_line_state = -2;  // parsing error
               break;
      case  2: // continue command set parsing
               // consume the character
               // "N\n"        show serial number and end command set parsing
               // "Ndddd\n"    set  serial number and end command set parsing
               // <other>      end command set parsing
               if (data == 'N') {
                 Uart_TX_put_char(uart, echo);                  // echo character
                 num                = 0;
                 digit_cnt          = 0;
                 command_line_state = 3;
                 }
               else command_line_state = -2;                    // parsing error
               break;
      case  3: // continue command set parsing
               // consume the character
               // "\n"        show serial number and end command set parsing
               // "dddd\n"    set  serial number and end command set parsing
               // <other>     end command set parsing
               if ((data >= '0') && (data <= '9')) {
                 Uart_TX_put_char(uart, echo);                  // echo character
                 num = num*10 + data - '0';
                 digit_cnt++;
                 }
               else if (data == '\r') {
                 // end of line character
                 // output "\r\n\n SERIAL NUMBER SET (0..9999) <%SN>: "
                 Uart_TX_put_str(uart, "\r\n\n SERIAL NUMBER SET (0..9999) <%SN>: ");

                 if (digit_cnt > 4) {
                    // too many digits
                    command_line_state = -2;                    // parsing error
                    }
                 if (digit_cnt > 0) {
                   // "SNdddd\n"
                   // set serial number
                   Serial_Number = num;

                   // show Serial_Number
                   Show_Serial_Number(uart);

                   // end command set parsing
                   command_line_state = -1;                     // end parsing
                   }
                 else {
                   // show serial number
                   Show_Serial_Number(uart);

                   // end command set parsing
                   command_line_state = -1;                     // end parsing
                   }
                 }
               else command_line_state = -2;                    // parsing error
               break;
      }

    // handle parsing errors
    if (command_line_state <= -2) {
      // parsing error
      // output "\r\n\n????"
      Uart_TX_put_str(uart, "\r\n\n????");
      command_line_state++;
      }

    // handle end of command set parsing
    if (command_line_state <= -1) {
      // end of command set parsing
      // output "\r\n\n"
      Uart_TX_put_str(uart, "\r\n\n>");
      command_line_state++;
      }

    // consume parsed characters
    Uart_RX_discard_chars(uart, discard_len);
    }
}

//------------------------------------------------------------------------------
// status report 02: Ball Crossing Event Report
// TOCA Target Goal Communication Definition Rev 09 page 24
//------------------------------------------------------------------------------
typedef __packed struct {
  uint8_t  status;                                                              // status                            = 0x84
  uint8_t  status_descriptor[2];                                                // command descriptor: ball crossing = '0','1'
  uint8_t  machine_id[2];                                                       // machine ID (goal address 01..04), not used = '0','0' (example)
  uint8_t  object_type_id[2];                                                   // "00" = non-ball "01" = ball
  uint8_t  elevation_pct[2];                                                    // "00" =    0% "64" = 100%
  uint8_t  velocity_pct[2];                                                     // "01" = 1 mph "64" = 100 mph
  uint8_t  ball_crossing_time_stamp[4];                                         // high byte, low byte
  uint8_t  color_change_time_stamp[4];                                          // high byte, low byte
  uint8_t  eof;                                                                 // 0xc4=end of packet
} Radio_TX_Ball_Crossing_Report_Msg_t;

//------------------------------------------------------------------------------
Radio_TX_Ball_Crossing_Report_Msg_t Radio_TX_Ball_Crossing_Report_Msg = {
  .status                   = 0x84,
  .status_descriptor        = {'0','2'},
  .machine_id               = {'0','0'},
  .object_type_id           = {'0','1'},                                        // "00" = non-ball "01" = ball
  .elevation_pct            = {'0','1'},                                        // "00" =    0% "64" = 100%
  .velocity_pct             = {'0','1'},                                        // "01" = 1 mph "64" = 100 mph
  .ball_crossing_time_stamp = {'0','0','0','0'},                                // high byte, low byte
  .color_change_time_stamp  = {'0','0','0','0'},                                // high byte, low byte
  .eof                      = 0xc4
};

//------------------------------------------------------------------------------
uint16_t Send_Ball_Crossing_Event_counter          = 0;
uint16_t Sent_Ball_Crossing_Event_counter          = 0;
bool          Ball_Crossing_Event_Holdoff_complete = true;

//------------------------------------------------------------------------------
void Send_Ball_Crossing_Event_Holdoff_complete(void) {
  Ball_Crossing_Event_Holdoff_complete = true;
}

//------------------------------------------------------------------------------
// object_type=0 for non-ball
// object_type=1 for     ball
void Send_Ball_Crossing_Event(uint16_t object_type,
                              uint16_t elevation_pct,
                              uint16_t velocity_pct) {

  // remember that we are starting a holdoff until light curtain is cleared
  Ball_Crossing_Event_Holdoff_complete = false;

  // latch timestamp of ball crossing event
  TimeStampCrossingCounter_100ms = TimeStampCounter_100ms;

  // report "ball" or "non-bal"
  // object_type_id = {'0','0'} for non-ball
  // object_type_id = {'0','1'} for     ball
  Radio_TX_Ball_Crossing_Report_Msg.object_type_id[1]           = '0' + object_type;    // object_type=0 for non-ball, object_type=1 for non-ball

  Radio_TX_Ball_Crossing_Report_Msg.elevation_pct[0]            = Convert_hex_to_ASCII(elevation_pct >> 4);
  Radio_TX_Ball_Crossing_Report_Msg.elevation_pct[1]            = Convert_hex_to_ASCII(elevation_pct >> 0);

  Radio_TX_Ball_Crossing_Report_Msg.velocity_pct[0]             = Convert_hex_to_ASCII(velocity_pct  >> 4);
  Radio_TX_Ball_Crossing_Report_Msg.velocity_pct[1]             = Convert_hex_to_ASCII(velocity_pct  >> 0);

  Radio_TX_Ball_Crossing_Report_Msg.ball_crossing_time_stamp[0] = Convert_hex_to_ASCII(TimeStampCrossingCounter_100ms >> 12);
  Radio_TX_Ball_Crossing_Report_Msg.ball_crossing_time_stamp[1] = Convert_hex_to_ASCII(TimeStampCrossingCounter_100ms >>  8);
  Radio_TX_Ball_Crossing_Report_Msg.ball_crossing_time_stamp[2] = Convert_hex_to_ASCII(TimeStampCrossingCounter_100ms >>  4);
  Radio_TX_Ball_Crossing_Report_Msg.ball_crossing_time_stamp[3] = Convert_hex_to_ASCII(TimeStampCrossingCounter_100ms >>  0);

  Radio_TX_Ball_Crossing_Report_Msg.color_change_time_stamp[0]  = Convert_hex_to_ASCII(TimeStampColorChangeCounter_100ms >> 12);
  Radio_TX_Ball_Crossing_Report_Msg.color_change_time_stamp[1]  = Convert_hex_to_ASCII(TimeStampColorChangeCounter_100ms >>  8);
  Radio_TX_Ball_Crossing_Report_Msg.color_change_time_stamp[2]  = Convert_hex_to_ASCII(TimeStampColorChangeCounter_100ms >>  4);
  Radio_TX_Ball_Crossing_Report_Msg.color_change_time_stamp[3]  = Convert_hex_to_ASCII(TimeStampColorChangeCounter_100ms >>  0);

  Send_Ball_Crossing_Event_counter++;
}

//------------------------------------------------------------------------------
// send ball crossing event to app
void Send_Ball_Crossing_Event_Task(void) {
  static uint32_t timeout;
  static int16_t  state = 0;

  switch (state) {
    case  0: if ((int16_t) (Send_Ball_Crossing_Event_counter - Sent_Ball_Crossing_Event_counter) < 1) break;
             Sent_Ball_Crossing_Event_counter++;
             state++;
    case  1: // send the ball crossing event report and setup repeat interval
             Uart_TX_put_buf(&Radio_Uart2, (uint8_t *) &Radio_TX_Ball_Crossing_Report_Msg, sizeof(Radio_TX_Ball_Crossing_Report_Msg));

             // assume non-ball object if repeating
             Radio_TX_Ball_Crossing_Report_Msg.object_type_id[1] = '0';

             // assume zero velocity if repeating
             Radio_TX_Ball_Crossing_Report_Msg.velocity_pct[0]   = '0';
             Radio_TX_Ball_Crossing_Report_Msg.velocity_pct[1]   = '0';

             timeout = HAL_GetTick() + 2162;
             state++;
             break;
    case  2: // stop repeating if holdoff complete
             // send the message again if timeout
             if (Ball_Crossing_Event_Holdoff_complete)          state = 0;      // holdoff complete, stop repeating
             else if (((int32_t) timeout - HAL_GetTick()) <= 0) state = 1;      // timeout, send the message again
             break;
    }
}

