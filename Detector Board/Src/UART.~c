//------------------------------------------------------------------------------
// exact match
// string 1, string 2, len
bool RX_String_Match(uint8_t *s1, uint8_t *s2, int16_t len) {
  while (--len >= 0) if (*s1++ != *s2++) return false;

  return true;
}

//------------------------------------------------------------------------------
// match with mask
// one-bits in the mask determine the bits of interest
// string 1, string 2, mask, len
bool RX_String_Mask_Match(uint8_t *s1, uint8_t *s2, uint8_t *mask, int16_t len) {
  while (--len >= 0) if ((*s1++ ^ *s2++) & *mask++) return false;

  return true;
}

//------------------------------------------------------------------------------
// convert hex nibble into ascii character
uint8_t Convert_hex_to_ASCII(uint16_t x) {
  // assure 0x00..0x0f
  x &= 0x0f;

  // check for 0..9
  if (x < 10) return x + '0';

  // must be in the range A..F
  return x + 'A' - 10;
}

//------------------------------------------------------------------------------
// convert one ascii character representing a hex nibble into uint16
//
// '0' = 0x30
// '1' = 0x31
// '2' = 0x32
// '3' = 0x33
// '4' = 0x34
// '5' = 0x35
// '6' = 0x36
// '7' = 0x37
// '8' = 0x38
// '9' = 0x39
// 'A' = 0x41      'a' = 0x61
// 'B' = 0x42      'b' = 0x62
// 'C' = 0x43      'c' = 0x63
// 'D' = 0x44      'd' = 0x64
// 'E' = 0x45      'e' = 0x65
// 'F' = 0x46      'f' = 0x66
//
uint16_t Convert_ASCII_byte_to_uint16(uint8_t c) {
  // assure upper-case only
  if (c >= 'a') c -= ('a' - 'A');                       // c -= 0x20

  // assume c is in the range of 0..9
  // remove '0' offset
  c -= '0';
  if (c < 10) return c;

  // assume c is in the range of A..F
  // undo '0' offset, remove 'A' offset, and add 10 (+ '0' - 'A' + 10 = -7)
  c -= 7;
  if (c < 16) return c;

  // invalid input
  return 0;
}

//------------------------------------------------------------------------------
// convert two ascii characters representing two hex nibbles into uint16
uint16_t Convert_ASCII_double_byte_to_uint16(uint8_t *s) {
  uint16_t x;

  x  = Convert_ASCII_byte_to_uint16(s[0]) << 4;         // upper nibble
  x |= Convert_ASCII_byte_to_uint16(s[1]) << 0;         // lower nibble

  return x;
}

//------------------------------------------------------------------------------
// convert four ascii characters representing four hex nibbles into uint16
uint16_t Convert_ASCII_quad_byte_to_uint16(uint8_t *s) {
  uint16_t x;

  x  = Convert_ASCII_byte_to_uint16(s[0]) << 12;        // upper nibble
  x |= Convert_ASCII_byte_to_uint16(s[1]) <<  8;
  x |= Convert_ASCII_byte_to_uint16(s[2]) <<  4;
  x |= Convert_ASCII_byte_to_uint16(s[3]) <<  0;        // lower nibble

  return x;
}

