//------------------------------------------------------------------------------
// send Serial_Number to radio (and then on to USB term)
void Show_Serial_Number(uart_t *uart) {
  uint8_t  str[6];                              // dddddd
  uint16_t num = Serial_Number;
  int16_t  i;

  for (i = sizeof(str)-1; i >= 0; i--) {
    str[i] = (num % 10) + '0';
    num /= 10;
    }

  Uart_TX_put_buf(uart, str, sizeof(str));
}

